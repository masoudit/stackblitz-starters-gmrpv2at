    "components": {
      "securitySchemes": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "description": "Every protected call needs Authorization: Bearer <token>[cite: 1]"
        }
      },
      "schemas": {
        "Error": {
          "type": "object",
          "properties": {
            "key": { "type": "string" },
            "message": { "type": "string" },
            "statusCode": { "type": "string" }
          },
          "description": "Every failed call returns the same JSON shape[cite: 1]"
        },
        "Size": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "type": "string", "description": "category or dimension or slug[cite: 1]" },
            "value": { "type": "string", "description": "category size ID, dimension string L,W,H, or slug ID[cite: 1]" }
          }
        },
        "Terminal": {
          "type": "object",
          "required": ["latitude", "longitude", "type", "reference", "phoneNumber"],
          "properties": {
            "latitude": { "type": "string" },
            "longitude": { "type": "string" },
            "type": { "type": "string", "description": "pickup or drop[cite: 1]" },
            "reference": { "type": "string", "description": "Numeric string, defines stop order. e.g. '1'[cite: 1]" },
            "phoneNumber": { "type": "string", "description": "Contact phone[cite: 1]" },
            "address": { "type": "string" },
            "contactName": { "type": "string" },
            "comment": { "type": "string" }
          }
        },
        "OrderCreateRequest": {
          "type": "object",
          "required": ["refId", "terminals", "deliveryCategory", "paymentType"],
          "properties": {
            "refId": { "type": "string", "description": "Your unique business reference (idempotency key)[cite: 1]" },
            "terminals": { "type": "array", "items": { "$ref": "#/components/schemas/Terminal" } },
            "deliveryCategory": { "type": "string" },
            "paymentType": { "type": "string", "description": "Only prepaid, cod, postpaid[cite: 1]" },
            "city": { "type": "string" },
            "packages": { "type": "array", "items": { "type": "object" } },
            "totalPackageSize": { "type": "number" },
            "waitingTime": { "type": "integer" },
            "voucherCode": { "type": "string" },
            "hasReturn": { "type": "boolean" },
            "startTime": { "type": "string", "format": "date-time" },
            "endTime": { "type": "string", "format": "date-time" },
            "podEnabled": { "type": "boolean" },
            "popEnabled": { "type": "boolean" }
          }
        },
        "OrderCreateRequestV2": {
          "type": "object",
          "required": ["terminals", "deliveryCategory", "paymentType"],
          "properties": {
            "refId": { "type": "string", "description": "Optional (Required for Same-day)[cite: 1]" },
            "terminals": { "type": "array", "items": { "$ref": "#/components/schemas/Terminal" } },
            "deliveryCategory": { "type": "string", "description": "same-day, bike-without-box[cite: 1]" },
            "paymentType": { "type": "string" },
            "city": { "type": "string" },
            "timeSlot": { "type": "object", "description": "Required for Same-day[cite: 1]" },
            "packages": { "type": "array", "items": { "type": "object" }, "description": "Required for Same-day[cite: 1]" },
            "features": { "type": "object" },
            "totalPackageSize": { "type": "number" },
            "waitingTime": { "type": "integer" },
            "voucherCode": { "type": "string" },
            "hasReturn": { "type": "boolean" },
            "startTime": { "type": "string", "format": "date-time" },
            "endTime": { "type": "string", "format": "date-time" },
            "podEnabled": { "type": "boolean" },
            "popEnabled": { "type": "boolean" }
          }
        },
        "OrderCreateResponse": {
