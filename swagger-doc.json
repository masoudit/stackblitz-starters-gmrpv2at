            "receiver_terminal_id": { "type": "string" },
            "pickup_type": { "type": "string" },
            "value": { "type": "integer" },
            "breakable": { "type": "boolean" },
            "packaging": { "type": "boolean" }
          },
          "description": "CreateParcelReq object. Receiver info requires either receiver_terminal or receiver_terminal_id.[cite: 1]"
        }
      }
    }
