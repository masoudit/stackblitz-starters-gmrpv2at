          }
        },
        "NxpCreateParcelReq": {
          "type": "object",
          "required": ["timeline_id", "sender_terminal_id", "size"],
          "properties": {
            "timeline_id": { "type": "string" },
            "sender_terminal_id": { "type": "string" },
            "size": { "$ref": "#/components/schemas/Size" },
