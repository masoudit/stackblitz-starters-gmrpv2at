{
  "openapi": "3.0.3",
  "info": {
    "title": "Snapp Box Integration Gateway API",
    "version": "1.0.0",
    "description": "Integration guide for external partners building clients against the Snapp Box gateway."
  },
  "servers": [
    {
      "url": "https://"
    }
  ],
  "paths": {
    "/v1/oauth2/token": {
      "post": {
        "summary": "Get access token",
        "description": "Exchange client credentials for an access token. No auth header needed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["client_id", "client_secret"],
                "properties": {
                  "client_id": {
                    "type": "string",
                    "description": "Your issued client ID"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "Your issued client secret"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "token_type": { "type": "string" },
                    "expires_in": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/delivery-categories": {
      "get": {
        "summary": "List delivery categories",
        "description": "List delivery categories available for a location.",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": { "type": "number" },
            "example": 35.757523
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": { "type": "number" },
            "example": 51.409911
          }
        ],
        "responses": {
          "200": { "description": "Successful response" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v1/pricing": {
      "post": {
        "summary": "Get price quote (v1)",
        "description": "Get a price quote for a standard order before creating it.",
        "responses": {
          "200": { "description": "Successful response" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v2/pricing": {
      "post": {
        "summary": "Get price quote (v2)",
        "description": "Pricing endpoint for the v2 order flow.",
        "responses": {
          "200": { "description": "Successful response" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v1/orders": {
      "post": {
        "summary": "Create order (v1)",
        "description": "Create a new standard delivery order.",
        "responses": {
          "201": { "description": "Order created" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "get": {
        "summary": "List orders (v1)",
        "description": "List your orders with pagination and optional status filter.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Successful response" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
